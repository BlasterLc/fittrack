# ─────────────────────────────────────────────────────────
# Plantilla de variables de entorno del backend (FastAPI).
# Copiar a `.env` con los valores reales. `.env` está en .gitignore:
# NUNCA se versiona. Los secretos no van al repositorio ni al chat.
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# URL del proyecto (Supabase → Settings → API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secreto para validar los JWT que emite Supabase Auth
# (Settings → API → JWT Secret). SECRETO.
SUPABASE_JWT_SECRET=cambiar

# Clave service_role (Settings → API). SECRETA: la usa el backend para
# subir GIFs a Storage e invitar usuarios por la API admin. Nunca va al
# frontend ni al repositorio.
SUPABASE_SERVICE_ROLE_KEY=cambiar

# Bucket de Storage donde viven las animaciones del catálogo.
SUPABASE_STORAGE_BUCKET=exercise-gifs

# ── Base de datos ─────────────────────────────────────────
# Producción: connection string de Supabase (Settings → Database).
# Incluye la contraseña (SECRETA). Anteponer `+psycopg` al esquema.
# Si el host de FastAPI no tiene IPv6, usar la connection string del
# pooler en modo Session (IPv4), no la conexión directa.
DATABASE_URL=postgresql+psycopg://postgres:[CONTRASEÑA]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Base local separada para las pruebas. Se borra y recrea en cada corrida.
# Los tests corren contra Postgres LOCAL, no contra Supabase.
TEST_DATABASE_URL=postgresql+psycopg://fittrack:fittrack@localhost:5432/fittrack_test

# ── Otros ─────────────────────────────────────────────────
# Clave de Anthropic: análisis de comida y script de traducción del catálogo.
ANTHROPIC_API_KEY=sk-ant-...

# Origen de la PWA (Vercel), para habilitar CORS. Sin setear, el middleware
# de CORS no se agrega y nada cambia (así siguen local/tests hoy). Sin barra
# final: "https://fittrack.vercel.app", no ".../".
WEB_ORIGIN=https://fittrack.vercel.app

# Carpeta local de staging: se descargan los GIFs acá antes de subirlos a Storage.
MEDIA_DIR=./media/gifs

# ─────────────────────────────────────────────────────────
# NOTA: la app (React Native + Expo) usa su propio archivo de entorno con
#   EXPO_PUBLIC_SUPABASE_URL  y  EXPO_PUBLIC_SUPABASE_ANON_KEY
# La clave `anon` sí es pública (va embebida en el cliente). La `service_role`
# NO: esa vive solo acá, en el backend.
# ─────────────────────────────────────────────────────────
