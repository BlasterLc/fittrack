# Contraseña única de la API. Se envía en el header X-Password.
APP_PASSWORD=cambiar

# Cadena de conexión de Railway. En local: postgresql+psycopg://user:pass@localhost/fittrack
DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/fittrack

# Base separada para las pruebas. Se borra y recrea en cada corrida.
TEST_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/fittrack_test

# Clave de Anthropic, usada solo por el script de traducción.
ANTHROPIC_API_KEY=sk-ant-...

# Carpeta donde viven las animaciones descargadas.
MEDIA_DIR=./media/gifs
